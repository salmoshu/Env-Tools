# 日志
**/log/

# Python 缓存/编译产物
__pycache__/
*.py[cod]

# 壁纸缓存（本机数据，首次部署时自动迁移/重建）
windows/kdesk/wallpaper_cache/

# kdesk 本机状态（安装路径缓存等）
windows/kdesk/scripts/data/

# 官方安装包（部署直接使用 kdesk_33_1_backup 快照，无需安装包）
windows/kdesk/①官方安装版kdesk_33_1.exe

# nodejs 便携版运行时（部署时自动下载）
*/nodejs/runtime/

# Electron 窗口依赖（首次 Ctrl+E 前 npm install 生成）
node_modules/
package-lock.json

# 桌面应用构建产物（release 压缩包与 Rust 编译输出不入库，发布时作为 release 资产）
app/release/
app/release-staging/
app/backend-rs/target/
windows/kdesk/kdesk_33_1_backup/
